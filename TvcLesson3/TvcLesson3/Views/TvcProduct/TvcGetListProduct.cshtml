@model List<TvcLesson3.Models.TvcProduct>
@{
    ViewData["Title"] = "Danh sách sản phẩm (List model)";
    int stt = 0;
}

<div class="card">
    <div class="card-header">
        <h1>@ViewData["Title"]</h1>
    </div>
    <div class="card-body">
        <table class="table table-bordered table-striped">
            <thead>
                <tr>
                    <th>#</th>
                    <th>ID</th>
                    <th>Name</th>
                    <th>Year</th>
                    <th>Price$</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    stt++;
                    <tr>
                        <td>@stt</td>
                        <td>@item.TvcProductId</td>
                        <td>@item.TvcProductName</td>
                        <td>@item.TvcYearRelease</td>
                        <td>@item.TvcPrice</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <th colspan="6"> Tổng số sản phẩm: @Model.Count</th>
                </tr>
            </tfoot>
        </table>
    </div>
</div>
