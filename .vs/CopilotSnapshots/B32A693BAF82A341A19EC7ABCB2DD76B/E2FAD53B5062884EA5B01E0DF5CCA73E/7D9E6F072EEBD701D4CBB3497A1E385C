@model TvcLesson09Annotation.Models.DataViewModels.TvcProductVM

@{
    ViewData["Title"] = "Chỉnh sửa sản phẩm";
}

<div class="card p-3">
    <h1>Chỉnh sửa sản phẩm</h1>
    <hr />
    <div class="row">
        <div class="col-md-6">
            <form asp-action="Edit" method="post" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input type="hidden" asp-for="Product.Id" />
                <input type="hidden" asp-for="Product.Image" /> <!-- Giữ lại ảnh cũ nếu không chọn ảnh mới -->

                <div class="form-group">
                    <label asp-for="Product.Name" class="control-label"></label>
                    <input asp-for="Product.Name" class="form-control" />
                    <span asp-validation-for="Product.Name" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Product.Price" class="control-label"></label>
                    <input asp-for="Product.Price" class="form-control" />
                    <span asp-validation-for="Product.Price" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Product.SalePrice" class="control-label"></label>
                    <input asp-for="Product.SalePrice" class="form-control" />
                    <span asp-validation-for="Product.SalePrice" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Product.Description" class="control-label"></label>
                    <textarea asp-for="Product.Description" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Product.Description" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Product.CategoryId" class="control-label"></label>
                    <select asp-for="Product.CategoryId" class="form-control" asp-items="@Model.Categories">
                        <option value="">-- Chọn danh mục --</option>
                    </select>
                    <span asp-validation-for="Product.CategoryId" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label class="control-label">Hình ảnh hiện tại</label><br />
                    <img src="@Model.Product.Image" style="width: 150px; height: auto;" />
                </div>

                <div class="form-group">
                    <label class="control-label">Chọn ảnh mới (nếu muốn thay đổi)</label>
                    <input type="file" name="imageFile" class="form-control" accept="image/*" />
                </div>

                <div class="form-group my-2">
                    <input type="submit" value="Cập nhật" class="btn btn-primary" />
                    <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}