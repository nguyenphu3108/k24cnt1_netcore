@model TvcLesson09Annotation.Models.DataViewModels.TvcMemberRegister
@{
    ViewData["Title"] = "Create";
}

<div class="card p-3">
    <h1>Thêm mới thành viên</h1>
    <hr />
    <div class="row">
        <div class="col-md-6">
            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="form-group">
                    <label asp-for="TvcMemberId" class="control-label"></label>
                    <input asp-for="TvcMemberId" class="form-control" />
                    <span asp-validation-for="TvcMemberId" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="TvcUserName" class="control-label"></label>
                    <input asp-for="TvcUserName" class="form-control" />
                    <span asp-validation-for="TvcUserName" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="TvcPassword" class="control-label"></label>
                    <input asp-for="TvcPassword" class="form-control" />
                    <span asp-validation-for="TvcPassword" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="TvcFullName" class="control-label"></label>
                    <input asp-for="TvcFullName" class="form-control" />
                    <span asp-validation-for="TvcFullName" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="TvcEmail" class="control-label"></label>
                    <input asp-for="TvcEmail" class="form-control" />
                    <span asp-validation-for="TvcEmail" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="TvcPhoneNumber" class="control-label"></label>
                    <input asp-for="TvcPhoneNumber" class="form-control" />
                    <span asp-validation-for="TvcPhoneNumber" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="TvcBirthday" class="control-label"></label>
                    <input asp-for="TvcBirthday" class="form-control" type="date" />
                    <span asp-validation-for="TvcBirthday" class="text-danger"></span>
                </div>

                <div class="form-group my-2">
                    <input type="submit" value="Ghi lại" class="btn btn-primary" />
                    <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
                </div>
            </form>
        </div>
    </div>
</div>
